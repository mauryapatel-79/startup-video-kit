# Copy to .env. Every key is optional: with none, the kit uses free local tools
# (Kokoro voice, whisper/Parakeet captions, bundled + Openverse sound effects).

# Premium voice, music and sound effects. https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# HeyGen voices, music catalog, avatars. Prefer `npx hyperframes auth login` instead of a key.
HEYGEN_API_KEY=
